// ---------------------------------------------------------------------------
// Values used by both updates() and the baked defaults
// ---------------------------------------------------------------------------

fn dot_range() -> String {
  "[" <> string.join(list.map(int_range(0, 23), int.to_string), ", ") <> "]"
}

fn int_range(from: Int, to: Int) -> List(Int) {
  case from > to {
    True -> []
    False -> [from, ..int_range(from + 1, to)]
  }
}
