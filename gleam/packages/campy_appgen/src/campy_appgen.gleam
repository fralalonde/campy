//// App generation for ABI v2 (ADR 0004).
////
//// One generated module per form: the designed document is embedded as
//// `view/1`, and the module carries the user's handlers verbatim, so the
//// whole app — `init/0`, `view/1`, and the `<control>_<event>` handlers —
//// lives in a single module that `campy_app` can dispatch on by
//// `function_exported`. The generated text depends only on `campy_view` and
//// `campy_app` at runtime; this package is a build-time tool.
////
//// The user's `handlers.gleam` is the source of truth for state and
//// behaviour: it is appended verbatim (its own imports are merged into the
//// generated import block, and its leading `////` doc comments stay at the
//// top of the module). Declared events without a handler get an ABI v2 no-op
//// stub so the skeleton runs before the user writes handlers.

import campy_source
import campy_view.{type Document, type Node}
import gleam/int
import gleam/list
import gleam/option.{type Option, None, Some}
import gleam/result
import gleam/string

/// The dispatch module name `campy_app.Spec.module` should point at.
pub fn module_name(slug: String) -> String {
  "campy_app_" <> slug
}

/// Generate the app module for one form. Fails with a precise message when
/// the slug or the handler source cannot support an ABI v2 module.
pub fn generate(
  slug: String,
  document: Document,
  handlers: String,
) -> Result(String, String) {
  use _ <- result.try(check_slug(slug))
  use _ <- result.try(check_handlers(handlers))
  let #(doc_lines, source) = split_doc(handlers)
  let #(hoisted, body) = split_imports(source, [])
  let runtime_imports = merge_runtime_imports(hoisted)
  let view = qualify_constructors(render_view(document))
  let stubs = missing_stubs(document.view, handlers)
  let header = [
    "// Generated by Campy appgen from modules/",
    slug,
    "/. The generated section embeds the form; the handlers below are your\n",
    "// `handlers.gleam` verbatim. Regenerate instead of editing.\n",
    "\n",
  ]

  Ok(
    string.concat(
      list.append(list.append(doc_lines, header), [
        runtime_imports,
        "\n// --- generated: embedded form view ------------------------------\n\n",
        view,
        "\n\n// --- handlers (verbatim from handlers.gleam) ---------------------\n\n",
        body,
        stubs,
      ]),
    ),
  )
}

fn render_view(document: Document) -> String {
  let lines =
    campy_source.node_lines(document.view, 4)
    |> string.join("\n")

  [
    "pub fn view(_state: State) -> Document {\n",
    "  campy_view.Document(\n",
    "    schema: ",
    int.to_string(document.schema),
    ",\n",
    "    view:\n",
    lines,
    ",\n",
    "    extra: [],\n",
    "  )\n",
    "}\n",
  ]
  |> string.concat
}

/// No-op ABI v2 stubs for events the handlers do not implement yet, so the
/// generated skeleton runs before the user writes the real handlers.
fn missing_stubs(root: Node, handlers: String) -> String {
  stub_lines(declared_events(root), handlers, [])
  |> string.concat
}

fn declared_events(node: Node) -> List(#(String, String)) {
  let own = list.map(node.events, fn(key) { #(node.id, key) })
  let nested = list.flatten(list.map(node.children, declared_events))
  list.append(own, nested)
}

fn stub_lines(
  pending: List(#(String, String)),
  handlers: String,
  emitted: List(String),
) -> List(String) {
  case pending {
    [] ->
      case emitted {
        [] -> []
        _ ->
          list.append(
            [
              "\n\n// --- generated: ABI v2 stubs for events without handlers ---------\n",
            ],
            list.append(emitted, [""]),
          )
      }
    [#(control, key), ..rest] -> {
      let name = control <> "_" <> key
      case string.contains(handlers, "pub fn " <> name <> "(") {
        True -> stub_lines(rest, handlers, emitted)
        False -> {
          let stub =
            "pub fn "
            <> name
            <> "(state: State, event: Event) -> #(State, List(Effect)) {\n"
            <> "  let _ = event\n"
            <> "  #(state, [])\n"
            <> "}\n"
          stub_lines(rest, handlers, list.append(emitted, [stub]))
        }
      }
    }
  }
}

/// Leading `////` module doc comments must stay at the top of the generated
/// module, before every import.
fn split_doc(source: String) -> #(List(String), String) {
  case string.trim_start(source) {
    "" -> #([], "")
    rest ->
      case string.split_once(rest, "\n") {
        Error(_) -> #([], rest)
        Ok(#(line, tail)) ->
          case string.starts_with(line, "////") {
            True -> {
              let #(lines, remainder) = split_doc(tail)
              #([line <> "\n", ..lines], remainder)
            }
            False -> #([], rest)
          }
      }
  }
}

/// Import lines are hoisted from the handler body (comments stay where they
/// are) so they can be merged into the generated import block.
fn split_imports(
  source: String,
  hoisted: List(String),
) -> #(List(String), String) {
  case string.split_once(source, "\n") {
    Error(_) -> #(hoisted, source)
    Ok(#(line, tail)) ->
      case is_import(line) {
        True -> split_imports(tail, list.append(hoisted, [line]))
        False -> {
          let #(hoisted, body) = split_imports(tail, hoisted)
          #(hoisted, line <> "\n" <> body)
        }
      }
  }
}

fn is_import(line: String) -> Bool {
  string.starts_with(string.trim(line), "import ")
}

/// The generated module imports the runtime contracts; user imports of the
/// same module are merged into that block instead of duplicated, so the
/// handler's own `import campy_view.VText` survives.
fn merge_runtime_imports(hoisted: List(String)) -> String {
  let #(app_items, view_items, other) = partition_imports(hoisted, [], [], [])

  let app_block =
    "import campy_app.{"
    <> string.join(merge_names(["type Event", "type Effect"], app_items), ", ")
    <> "}"
  let view_block =
    "import campy_view.{"
    <> string.join(merge_names(["type Document"], view_items), ", ")
    <> "}"

  case other {
    [] -> app_block <> "\n" <> view_block <> "\n"
    _ ->
      string.concat(list.append(
        [app_block <> "\n", view_block <> "\n"],
        list.append(other, ["\n"]),
      ))
  }
}

fn partition_imports(
  lines: List(String),
  app: List(String),
  view: List(String),
  other: List(String),
) -> #(List(String), List(String), List(String)) {
  case lines {
    [] -> #(app, view, other)
    [line, ..rest] ->
      case import_path(line) {
        Error(Nil) ->
          partition_imports(rest, app, view, list.append(other, [line <> "\n"]))
        Ok(path) ->
          case path {
            "campy_app" ->
              partition_imports(
                rest,
                list.append(app, import_items(line)),
                view,
                other,
              )
            "campy_view" ->
              partition_imports(
                rest,
                app,
                list.append(view, import_items(line)),
                other,
              )
            _ ->
              partition_imports(
                rest,
                app,
                view,
                list.append(other, [line <> "\n"]),
              )
          }
      }
  }
}

fn merge_names(base: List(String), extra: List(String)) -> List(String) {
  list.fold(extra, base, fn(names, name) {
    case name == "" || list.contains(names, name) {
      True -> names
      False -> list.append(names, [name])
    }
  })
}

/// The unqualified names an import brings in: `import m.{a, type B}` ->
/// ["a", "type B"]; `import m.Name` -> ["Name"]; aliased and whole-module
/// imports bring in nothing we can merge.
fn import_items(line: String) -> List(String) {
  let after = string.drop_start(string.trim(line), string.length("import "))

  case string.split_once(after, "{") {
    Ok(#(_path, braced)) ->
      string.drop_end(braced, 1)
      |> string.split(",")
      |> list.map(string.trim)
    Error(Nil) ->
      case string.split_once(after, " ") {
        // `import x as y`: aliased, nothing unqualified.
        Ok(#(_path, _alias)) -> []
        Error(Nil) ->
          case qualified_constructor(after) {
            Some(name) -> [name]
            None -> []
          }
      }
  }
}

/// A bare `import m.Name` is a constructor import when the text after the
/// last dot starts with an uppercase letter; `import gleam/int` is a whole
/// module import and contributes no unqualified names.
fn qualified_constructor(text: String) -> Option(String) {
  let parts = string.split(text, ".")
  case list.reverse(parts) {
    [last, ..] ->
      case string.to_utf_codepoints(last) {
        [first, ..] -> {
          let code = string.utf_codepoint_to_int(first)
          case code >= 65 && code <= 90 {
            True -> Some(last)
            False -> None
          }
        }
        [] -> None
      }
    [] -> None
  }
}

/// The module path of an import line, without a trailing dot.
fn import_path(line: String) -> Result(String, Nil) {
  let after = string.drop_start(string.trim(line), string.length("import "))

  case string.split_once(after, "{") {
    Ok(#(before, _braced)) -> Ok(strip_dots(before))
    Error(Nil) ->
      case string.split_once(after, " ") {
        Ok(#(path, _alias)) -> Ok(strip_dots(path))
        Error(Nil) ->
          case qualified_constructor(after) {
            Some(name) ->
              Ok(strip_dots(string.drop_end(after, string.length(name))))
            None -> Ok(string.trim(after))
          }
      }
  }
}

fn strip_dots(path: String) -> String {
  case string.ends_with(path, ".") {
    True -> string.drop_end(path, 1)
    False -> path
  }
}

/// Value constructors in the rendered view are qualified so the generated
/// import block only carries the runtime contracts and whatever the user's
/// handlers import themselves.
fn qualify_constructors(view: String) -> String {
  ["VBool", "VFloat", "VInt", "VList", "VMap", "VNull", "VText"]
  |> list.fold(view, fn(text, name) {
    string.replace(text, name <> "(", "campy_view." <> name <> "(")
  })
}

fn check_slug(slug: String) -> Result(Nil, String) {
  case slug {
    "" -> Error("appgen: module slug must not be empty")
    _ ->
      case is_slug(slug) {
        True -> Ok(Nil)
        False -> Error("appgen: invalid module slug: " <> slug)
      }
  }
}

fn is_slug(slug: String) -> Bool {
  slug
  |> string.to_utf_codepoints
  |> list.all(fn(codepoint) {
    let code = string.utf_codepoint_to_int(codepoint)
    code == 95 || code >= 97 && code <= 122 || code >= 48 && code <= 57
  })
}

fn check_handlers(handlers: String) -> Result(Nil, String) {
  case string.trim(handlers) {
    "" -> Error("appgen: handlers source is empty")
    source ->
      case string.contains(source, "pub type State") {
        False -> Error("appgen: handlers must define `pub type State`")
        True ->
          case string.contains(source, "pub fn init(") {
            False -> Error("appgen: handlers must define `pub fn init/0`")
            True ->
              case string.contains(source, "pub fn view(") {
                True ->
                  Error(
                    "appgen: handlers must not define view/1; it is generated",
                  )
                False -> Ok(Nil)
              }
          }
      }
  }
}
