import campy_form
import campy_form/project
import gleam/list
import gleam/option.{Some}
import gleeunit
import gleeunit/should

pub fn main() {
  gleeunit.main()
}

// The dogfood fixture is generated by scripts/make_dogfood.py (`just dogfood`)
// and checked in. This test only reads it: from the package root during a
// scoped `gleam test`, or below CAMPY_ROOT in the full-tree runner.
fn fixture() -> project.Project {
  let candidates = [
    "test/dogfood_fixture.campy",
    "gleam/packages/campy_form/test/dogfood_fixture.campy",
  ]
  let assert Ok(loaded) = list.find_map(candidates, project.load)
  loaded
}

pub fn dogfood_fixture_roundtrips_external_sources_test() {
  let loaded = fixture()
  loaded.version |> should.equal(project.version)
  loaded.title |> should.equal("Campy Dev")
  list.length(loaded.modules) |> should.equal(5)

  loaded.modules
  |> list.map(fn(module) { module.source_origin })
  |> should.equal([
    project.External("gleam/apps/campy_ide/src/campy_ide.gleam"),
    project.External("gleam/apps/campy_ide/src/campy_ide/state.gleam"),
    project.External("gleam/packages/campy_form/src/campy_form.gleam"),
    project.External("gleam/packages/campy_bridge/src/campy_bridge.gleam"),
    project.External("gleam/packages/campy_ccl/src/campy_ccl.gleam"),
  ])
}

pub fn dogfood_fixture_modules_have_default_forms_test() {
  let loaded = fixture()
  let assert Some(module) = project.find_module(loaded, "campy-ide")
  module.form.width |> should.equal(240)
  module.form.height |> should.equal(160)
  module.form.controls
  |> list.map(fn(control) { control.kind })
  |> should.equal([campy_form.Label, campy_form.Button])
}
