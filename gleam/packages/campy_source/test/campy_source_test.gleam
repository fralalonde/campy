pub fn strings_are_escaped_for_gleam_test() {
  let document =
    campy_view.Document(
      schema: 1,
      view: campy_view.node("form", "root")
        |> campy_view.with_props([
          #("quote", VText("say \"hi\"")),
          #("slash", VText("a\\b")),
          #("lines", VText("a\nb\rc\td")),
          #("control", VText("x" <> control_one() <> "y")),
        ]),
      extra: [],
    )

  let source = campy_source.generate("escape", document)
  source |> assert_contains("#(\"quote\", VText(\"say \\\"hi\\\"\")),")
  source |> assert_contains("#(\"slash\", VText(\"a\\\\b\")),")
  source |> assert_contains("#(\"lines\", VText(\"a\\nb\\rc\\td\")),")
  source |> assert_contains("#(\"control\", VText(\"x\\u{1}y\")),")
}

fn control_one() -> String {
  let assert Ok(codepoint) = string.utf_codepoint(1)
  string.from_utf_codepoints([codepoint])
}

pub fn floats_always_carry_a_decimal_point_test() {
  let document =
    campy_view.Document(
      schema: 1,
      view: campy_view.node("form", "root")
        |> campy_view.with_props([
          #("a", VFloat(1.0)),
          #("b", VFloat(2.5)),
          #("c", VFloat(-0.25)),
        ]),
      extra: [],
    )

  let source = campy_source.generate("floats", document)
  source |> assert_contains("#(\"a\", VFloat(1.0)),")
  source |> assert_contains("#(\"b\", VFloat(2.5)),")
  source |> assert_contains("#(\"c\", VFloat(-0.25)),")
}

pub fn nested_values_are_rendered_test() {
  let document =
    campy_view.Document(
      schema: 1,
      view: campy_view.node("form", "root")
        |> campy_view.with_props([
          #("on", VBool(True)),
          #("off", VBool(False)),
          #("none", VNull),
          #("items", VList([VText("a"), VInt(2)])),
          #("map", VMap([#("z", VInt(1)), #("a", VText("b"))])),
        ]),
      extra: [#("future", VText("dropped"))],
    )

  let source = campy_source.generate("values", document)
  source |> assert_contains("#(\"items\", VList([VText(\"a\"), VInt(2)])),")
  source
  |> assert_contains(
    "#(\"map\", VMap([#(\"a\", VText(\"b\")), #(\"z\", VInt(1))])),",
  )
  source |> assert_contains("#(\"none\", VNull),")
  source |> assert_contains("#(\"off\", VBool(False)),")
  source |> assert_contains("#(\"on\", VBool(True)),")
  source |> assert_omits("future")
  source |> assert_omits("dropped")
}

/// The demo greeter form, mirrored here so this package stays IO-free.
fn greeter() -> campy_view.Document {
  campy_view.Document(
    schema: 1,
    view: campy_view.node("form", "root")
      |> campy_view.with_props([
        #("h", VInt(400)),
        #("layout", VText("column")),
        #("title", VText("Greeter")),
        #("w", VInt(600)),
      ])
      |> campy_view.with_children([
        campy_view.node("label", "hello")
          |> campy_view.with_props([#("text", VText("Hello from Campy"))]),
        campy_view.node("text", "name")
          |> campy_view.with_props([
            #("text", VText("your name")),
            #("w", VInt(240)),
          ]),
      ]),
    extra: [],
  )
}

pub fn greeter_source_has_the_expected_structure_test() {
  let source = campy_source.generate("greeter", greeter())
  source |> assert_contains("modules/greeter/form.json")
  source |> assert_contains("campy_view.node(\"form\", \"root\")")
  source |> assert_contains("#(\"layout\", VText(\"column\")),")
  source |> assert_contains("campy_view.node(\"label\", \"hello\")")
  source |> assert_contains("#(\"text\", VText(\"Hello from Campy\")),")
  source |> assert_contains("campy_view.node(\"text\", \"name\")")
  source |> assert_contains("#(\"text\", VText(\"your name\")),")
  source |> assert_contains("#(\"w\", VInt(240)),")
  source |> assert_omits("with_events")
}

pub fn output_ends_with_a_newline_and_uses_lf_test() {
  let source = campy_source.generate("demo", small_document())
  string.ends_with(source, "\n") |> should.equal(True)
  string.ends_with(source, "\n\n") |> should.equal(False)
  string.contains(source, "\r") |> should.equal(False)
}

fn assert_contains(source: String, needle: String) {
  source |> string.contains(needle) |> should.equal(True)
}

fn assert_omits(source: String, needle: String) {
  source |> string.contains(needle) |> should.equal(False)
}
