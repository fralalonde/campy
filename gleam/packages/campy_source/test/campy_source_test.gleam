import campy_source
import campy_view.{VBool, VFloat, VInt, VList, VMap, VNull, VText}
import gleam/list
import gleam/string
import gleeunit
import gleeunit/should

pub fn main() {
  gleeunit.main()
}

fn small_document() -> campy_view.Document {
  campy_view.Document(
    schema: 1,
    view: campy_view.node("form", "root")
      |> campy_view.with_props([
        #("title", VText("Greeter")),
        #("w", VInt(600)),
        #("h", VInt(320)),
      ])
      |> campy_view.with_children([
        campy_view.node("button", "go")
        |> campy_view.with_key("primary")
        |> campy_view.with_props([
          #("w", VInt(80)),
          #("text", VText("Go")),
        ])
        |> campy_view.with_events(["click"])
        |> campy_view.with_children([
          campy_view.node("label", "cap")
          |> campy_view.with_props([#("text", VText("Hi"))]),
        ]),
      ]),
    extra: [],
  )
}

pub fn generates_exact_module_text_test() {
  campy_source.generate("demo", small_document())
  |> should.equal(
    "//// Generated by Campy from modules/demo/form.json. Do not edit.\n"
    <> "////\n"
    <> "//// A target-neutral campy_view.Node tree; renderers consume it. Document\n"
    <> "//// `extra` fields are metadata and are omitted from the runtime view.\n"
    <> "\n"
    <> "import campy_view.{type Node, VBool, VFloat, VInt, VList, VMap, VNull, VText}\n"
    <> "\n"
    <> "pub fn view() -> Node {\n"
    <> "  campy_view.node(\"form\", \"root\")\n"
    <> "  |> campy_view.with_props([\n"
    <> "    #(\"h\", VInt(320)),\n"
    <> "    #(\"title\", VText(\"Greeter\")),\n"
    <> "    #(\"w\", VInt(600)),\n"
    <> "  ])\n"
    <> "  |> campy_view.with_children([\n"
    <> "    campy_view.node(\"button\", \"go\")\n"
    <> "    |> campy_view.with_key(\"primary\")\n"
    <> "    |> campy_view.with_props([\n"
    <> "      #(\"text\", VText(\"Go\")),\n"
    <> "      #(\"w\", VInt(80)),\n"
    <> "    ])\n"
    <> "    |> campy_view.with_events([\"click\"])\n"
    <> "    |> campy_view.with_children([\n"
    <> "      campy_view.node(\"label\", \"cap\")\n"
    <> "      |> campy_view.with_props([\n"
    <> "        #(\"text\", VText(\"Hi\")),\n"
    <> "      ]),\n"
    <> "    ]),\n"
    <> "  ])\n"
    <> "}\n",
  )
}

pub fn key_and_events_are_omitted_when_unset_test() {
  let document =
    campy_view.Document(
      schema: 1,
      view: campy_view.node("form", "root"),
      extra: [],
    )

  let source = campy_source.generate("empty", document)
  source |> assert_contains("pub fn view() -> Node {\n  campy_view.node")
  source |> assert_omits("with_key")
  source |> assert_omits("with_events")
  source |> assert_omits("with_children")
  source |> assert_omits("with_props")
}

pub fn empty_children_do_not_emit_a_child_list_test() {
  let document =
    campy_view.Document(
      schema: 1,
      view: campy_view.node("form", "root")
        |> campy_view.with_children([
          campy_view.node("label", "only"),
        ]),
      extra: [],
    )

  let source = campy_source.generate("empty_children", document)
  source |> assert_contains("campy_view.node(\"label\", \"only\"),")
  source |> string.split("with_children") |> list.length |> should.equal(2)
}

