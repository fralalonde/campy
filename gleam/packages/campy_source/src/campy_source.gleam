//// Generated Gleam construction source for a form document.
////
//// The canonical form (`modules/<slug>/form.json`) is the source of truth
//// (ADR 0005). This module projects that tree into a read-only Gleam module
//// that builds the same `campy_view.Node` tree through the public DSL. It is
//// not a second source format: the output is derived and never loaded back.
////
//// The generated module is target-neutral (ADR 0004). It imports only
//// `campy_view`, so the wx renderer and any future renderer consume the same
//// construction. No wx calls are generated.
////
//// `Node.extra` is document metadata preserved for forward compatibility; it
//// is intentionally omitted from the runtime view. Nothing here reads or
//// writes files: the IDE decides where (if anywhere) the text goes.

import campy_view.{
  type Document, type Node, type Value, VBool, VFloat, VInt, VList, VMap, VNull,
  VText,
}
import gleam/float
import gleam/int
import gleam/list
import gleam/option.{None, Some}
import gleam/result
import gleam/string

/// Render one module's form as a standalone Gleam module. `slug` appears in
/// the header so the output names where it came from.
pub fn generate(slug: String, document: Document) -> String {
  let node = campy_view.normalize(document.view)

  string.concat([
    "//// Generated by Campy from modules/",
    slug,
    "/form.json. Do not edit.\n",
    "////\n",
    "//// A target-neutral campy_view.Node tree; renderers consume it. Document\n",
    "//// `extra` fields are metadata and are omitted from the runtime view.\n",
    "\n",
    "import campy_view.{type Node, VBool, VFloat, VInt, VList, VMap, VNull, VText}\n",
    "\n",
    "pub fn view() -> Node {\n",
    string.join(node_lines(node, 2), "\n"),
    "\n}\n",
  ])
}

/// Render a `campy_view.Node` as DSL lines at the given indentation. Public so
/// `campy_appgen` can embed the same construction in generated app modules.
pub fn node_lines(node: Node, indent: Int) -> List(String) {
  let pad = spaces(indent)
  let inner = indent + 2

  let head =
    pad
    <> "campy_view.node("
    <> quote(node.kind)
    <> ", "
    <> quote(node.id)
    <> ")"

  let with_key = case node.key {
    Some(key) -> [pad <> "|> campy_view.with_key(" <> quote(key) <> ")"]
    None -> []
  }

  let with_props = case node.props {
    [] -> []
    props ->
      list.append(
        [pad <> "|> campy_view.with_props(["],
        list.append(
          list.map(props, fn(field) {
            spaces(inner)
            <> "#("
            <> quote(field.0)
            <> ", "
            <> value_source(field.1)
            <> "),"
          }),
          [pad <> "])"],
        ),
      )
  }

  let with_events = case node.events {
    [] -> []
    events -> [
      pad
      <> "|> campy_view.with_events(["
      <> string.join(list.map(events, quote), ", ")
      <> "])",
    ]
  }

  let with_children = case node.children {
    [] -> []
    children ->
      list.append(
        [pad <> "|> campy_view.with_children(["],
        list.append(
          list.flatten(
            list.map(children, fn(child) {
              comma_last(node_lines(child, inner))
            }),
          ),
          [pad <> "])"],
        ),
      )
  }

  list.flatten([
    [head],
    with_key,
    with_props,
    with_events,
    with_children,
  ])
}

fn comma_last(lines: List(String)) -> List(String) {
  case list.reverse(lines) {
    [] -> []
    [last, ..rest] -> list.reverse([last <> ",", ..rest])
  }
}

/// Render a `campy_view.Value` as a Gleam literal. Public for appgen.
pub fn value_source(value: Value) -> String {
  case value {
    VText(text) -> "VText(" <> quote(text) <> ")"
    VBool(True) -> "VBool(True)"
    VBool(False) -> "VBool(False)"
    VInt(number) -> "VInt(" <> int.to_string(number) <> ")"
    VFloat(number) -> "VFloat(" <> float_literal(number) <> ")"
    VList(items) ->
      "VList([" <> string.join(list.map(items, value_source), ", ") <> "])"
    VMap(fields) ->
      "VMap(["
      <> string.join(
        list.map(sorted_fields(fields), fn(field) {
          "#(" <> quote(field.0) <> ", " <> value_source(field.1) <> ")"
        }),
        ", ",
      )
      <> "])"
    VNull -> "VNull"
  }
}

fn sorted_fields(fields: List(#(String, Value))) -> List(#(String, Value)) {
  list.sort(fields, by: fn(a, b) { string.compare(a.0, b.0) })
}

/// Gleam floats always need a decimal point or an exponent.
fn float_literal(number: Float) -> String {
  let text = float.to_string(number)
  case
    string.contains(text, ".")
    || string.contains(text, "e")
    || string.contains(text, "E")
  {
    True -> text
    False -> text <> ".0"
  }
}

fn quote(text: String) -> String {
  "\"" <> escape(text) <> "\""
}

fn escape(text: String) -> String {
  text
  |> string.to_utf_codepoints
  |> list.fold("", fn(acc, codepoint) { acc <> escape_codepoint(codepoint) })
}

fn escape_codepoint(codepoint: UtfCodepoint) -> String {
  let code = string.utf_codepoint_to_int(codepoint)
  case code {
    34 -> "\\\""
    92 -> "\\\\"
    10 -> "\\n"
    13 -> "\\r"
    9 -> "\\t"
    _ if code < 32 -> "\\u{" <> hex(code) <> "}"
    _ -> string.from_utf_codepoints([codepoint])
  }
}

fn hex(code: Int) -> String {
  result.unwrap(int.to_base_string(code, 16), "0")
}

fn spaces(count: Int) -> String {
  string.repeat(" ", count)
}
