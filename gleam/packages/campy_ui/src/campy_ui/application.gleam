// Application chrome belongs to the host, not to reusable component packages.
pub fn imports() -> String {
  "import { AboutSlint, Palette } from \"std-widgets.slint\";\n"
}

pub fn render(content: String) -> String {
  "callback quit();\ncallback about();\nforward-focus: application-focus;\n"
  <> "application-focus := FocusScope { forward-focus: menu-button;\n"
  <> "  KeyBinding {\n"
  <> "    keys: Platform.os == OperatingSystemType.windows ? @keys(Alt + F4) : @keys(Control + Q);\n"
  <> "    activated => { root.quit(); }\n"
  <> "  }\n"
  <> "  KeyBinding { keys: @keys(F10); activated => { application-menu.show({ x: 0px, y: 32px }); } }\n"
  <> "  VerticalLayout { spacing: 0px;\n"
  <> "    HorizontalLayout { padding-left: 12px; padding-top: 8px; padding-right: 12px; height: 40px;\n"
  <> "      application-menu := ContextMenuArea { width: 36px; height: 32px;\n"
  <> "        menu-button := Button { text: \"☰\"; accessible-label: \"Application menu\";\n"
  <> "          clicked => { application-menu.show({ x: 0px, y: 32px }); }\n"
  <> "        }\n"
  <> "        Menu {\n"
  <> "          MenuItem { title: \"About Campy\"; activated => { about-dialog.show(); root.about(); } }\n"
  <> "          MenuSeparator {}\n"
  <> "          MenuItem { title: \"Quit\"; activated => { root.quit(); } }\n"
  <> "        }\n"
  <> "      }\n"
  <> "      Rectangle { horizontal-stretch: 1; }\n"
  <> "    }\n"
  <> content
  <> "\n  }\n"
  <> "  about-dialog := PopupWindow {\n"
  <> "    x: max(12px, (root.width - self.width) / 2); y: 44px;\n"
  <> "    width: 360px; height: 250px;\n"
  <> "    close-policy: close-on-click-outside;\n"
  <> "    forward-focus: about-focus;\n"
  <> "    Rectangle { background: Palette.background; border-color: Palette.border; border-width: 1px; border-radius: 6px; }\n"
  <> "    about-focus := FocusScope { forward-focus: close-about;\n"
  <> "      VerticalLayout { padding: 20px; spacing: 10px;\n"
  <> "        Text { text: \"About Campy\"; font-size: 22px; font-weight: 600; color: Palette.foreground; }\n"
  <> "        Text { text: \"Version 0.1.0\\nGleam-first native RAD prototype\"; color: Palette.foreground; }\n"
  <> "        AboutSlint {}\n"
  <> "        close-about := Button { text: \"Close\"; clicked => { about-dialog.close(); } }\n"
  <> "      }\n"
  <> "    }\n"
  <> "  }\n"
  <> "}\n"
}
